{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "updater:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-copy-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-temp-read",
    "fs:allow-temp-write",
    "fs:allow-app-write",
    "fs:allow-app-read",
    "fs:allow-app-write-recursive",
    "fs:allow-watch",
    "os:default",
    "process:default",
    "shellx:allow-spawn",
    "shellx:allow-kill",
    "shellx:allow-open",
    "store:default",
    "svelte:default",
    "core:event:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "*/**"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "*/**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    "window-state:default"
  ]
}