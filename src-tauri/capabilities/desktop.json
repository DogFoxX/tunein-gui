{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "desktop-capability",
	"platforms": ["macOS", "windows", "linux"],
	"windows": ["main"],
	"permissions": [
		"opener:default",
		"dialog:default",
		"fs:default",
		"fs:allow-copy-file",
		"fs:allow-read-file",
		"fs:allow-write-file",
		"fs:allow-temp-read",
		"fs:allow-temp-write",
		"fs:allow-app-write",
		"fs:allow-app-read",
		"fs:allow-app-write-recursive",
		"fs:allow-watch",
		"os:default",
		"process:default",
		"shellx:allow-spawn",
		"shellx:allow-kill",
		"shellx:allow-open",
		"store:default",
		{
			"identifier": "opener:allow-open-path",
			"allow": [
				{
					"path": "*/**"
				}
			]
		},
		{
			"identifier": "fs:scope",
			"allow": [
				{
					"path": "*/**"
				}
			]
		},
		{
			"identifier": "http:default",
			"allow": [
				{
					"url": "https://*"
				}
			]
		},
		"window-state:default"
	]
}
