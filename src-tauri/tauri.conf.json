{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "tunein-gui",
	"mainBinaryName": "tunein-gui",
	"version": "0.1.2",
	"identifier": "com.tunein.gui",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Tunein GUI",
				"width": 1242,
				"minWidth": 906,
				"height": 768,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"backgroundColor": "#1E1E1E",
				"decorations": false,
				"dragDropEnabled": true,
				"visible": false
			}
		],
		"security": {
			"csp": "default-src http://*.localhost data:;",
			"assetProtocol": {
				"enable": true,
				"scope": ["*/**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["app", "appimage", "msi"],
		"windows": {
			"allowDowngrades": false,
			"certificateThumbprint": null,
			"digestAlgorithm": null,
			"nsis": null,
			"signCommand": null,
			"timestampUrl": null,
			"tsp": false,
			"webviewInstallMode": {
				"silent": true,
				"type": "downloadBootstrapper"
			},
			"wix": null
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEN0Q4RDA0ODFCMkY1ODYKUldTRzliS0JCSTE5blNmQ1JyWGlZMTBCcWFyWjdxdmFqYllUOWcyd0tibUF4dnR4VnhyZklDUTkK",
			"endpoints": [
				"https://github.com/DogFoxX/tunein-gui/releases/latest/download/latest.json"
			]
		}
	}
}
